{
  "$meta": {
    "name": "peak design tokens",
    "version": "0.1.0",
    "note": "Sorgente unica di verita'. tokens.css e' generato da qui con `npm run tokens:build`. Non modificare tokens.css a mano."
  },
  "color": {
    "terracotta": {
      "50": "#FDF1EC",
      "100": "#FADCD1",
      "200": "#F5BCA8",
      "300": "#F09A7F",
      "400": "#E9724C",
      "500": "#D45E39",
      "600": "#B54A2A",
      "700": "#8F3A20",
      "800": "#6B2B18",
      "900": "#47190E"
    },
    "miele": {
      "50": "#FEFAF0",
      "100": "#FDF2DC",
      "200": "#FCE7BE",
      "300": "#FCD589",
      "400": "#F7C463",
      "500": "#EFAE3D",
      "600": "#D9922A",
      "700": "#B0741F",
      "800": "#855717",
      "900": "#5A3A0F"
    },
    "bosco": {
      "50": "#EFF5F3",
      "100": "#D6E5E0",
      "200": "#ADCBC2",
      "300": "#7FAEA1",
      "400": "#4F8B7B",
      "500": "#2F6E5E",
      "600": "#26594C",
      "700": "#174036",
      "800": "#102D26",
      "900": "#081915"
    },
    "neutral": {
      "0": "#FFFFFF",
      "50": "#FAF9F7",
      "100": "#F5F4F2",
      "200": "#E8E5E0",
      "300": "#DFDCD7",
      "400": "#BDB8B0",
      "500": "#928C84",
      "600": "#6E6862",
      "700": "#4A443E",
      "800": "#33312E",
      "900": "#1B1A18",
      "1000": "#0F0E0D"
    },
    "state": {
      "success": "#2F6E5E",
      "warning": "#D9922A",
      "error": "#C0392B",
      "info": "#4A443E"
    }
  },
  "semantic": {
    "bg-page": "neutral.50",
    "bg-surface": "neutral.0",
    "bg-raised": "neutral.100",
    "bg-warm": "miele.50",
    "bg-inverse": "neutral.900",
    "bg-brand": "terracotta.400",
    "bg-brand-soft": "terracotta.50",
    "bg-forest": "bosco.500",

    "text-primary": "neutral.900",
    "text-secondary": "neutral.700",
    "text-muted": "neutral.600",
    "text-inverse": "neutral.0",
    "text-brand": "terracotta.600",
    "text-on-brand": "terracotta.900",
    "text-on-brand-large": "neutral.0",

    "border-subtle": "neutral.200",
    "border-default": "neutral.300",
    "border-strong": "neutral.400",
    "border-brand": "terracotta.400",

    "logo-fill": "miele.300",
    "logo-stroke": "terracotta.400",
    "logo-stroke-deep": "terracotta.700",

    "focus-ring": "terracotta.700"
  },
  "font": {
    "display": "'Rund Display', 'Gabarito', system-ui, sans-serif",
    "text": "'Rund Text', 'Inter', system-ui, sans-serif",
    "mono": "'DM Mono', ui-monospace, SFMono-Regular, Menlo, monospace"
  },
  "type": {
    "display-xl": { "size": "76px", "lineHeight": "0.95", "tracking": "-0.05em",  "family": "display", "weight": "900", "case": "lowercase" },
    "display-lg": { "size": "58px", "lineHeight": "0.98", "tracking": "-0.045em", "family": "display", "weight": "900", "case": "lowercase" },
    "display-md": { "size": "42px", "lineHeight": "1.0",  "tracking": "-0.04em",  "family": "display", "weight": "900", "case": "lowercase" },
    "display-sm": { "size": "32px", "lineHeight": "1.05", "tracking": "-0.035em", "family": "display", "weight": "900", "case": "lowercase" },
    "heading-lg": { "size": "26px", "lineHeight": "1.15", "tracking": "-0.03em",  "family": "text",    "weight": "600", "case": "none" },
    "heading-md": { "size": "21px", "lineHeight": "1.2",  "tracking": "-0.02em",  "family": "text",    "weight": "600", "case": "none" },
    "heading-sm": { "size": "18px", "lineHeight": "1.3",  "tracking": "-0.015em", "family": "text",    "weight": "600", "case": "none" },
    "body-lg":    { "size": "18px", "lineHeight": "1.6",  "tracking": "0",        "family": "text",    "weight": "400", "case": "none" },
    "body-md":    { "size": "16px", "lineHeight": "1.6",  "tracking": "0",        "family": "text",    "weight": "400", "case": "none" },
    "body-sm":    { "size": "14px", "lineHeight": "1.55", "tracking": "0",        "family": "text",    "weight": "400", "case": "none" },
    "mono-md":    { "size": "12px", "lineHeight": "1.4",  "tracking": "0.14em",   "family": "mono",    "weight": "500", "case": "uppercase" },
    "mono-sm":    { "size": "10px", "lineHeight": "1.4",  "tracking": "0.16em",   "family": "mono",    "weight": "500", "case": "uppercase" }
  },
  "space": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px",
    "24": "96px",
    "32": "128px"
  },
  "control": {
    "sm": "36px",
    "md": "44px",
    "lg": "56px"
  },
  "radius": {
    "sm": "8px",
    "md": "14px",
    "lg": "22px",
    "xl": "30px",
    "2xl": "44px",
    "full": "9999px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(27,26,24,.06)",
    "md": "0 4px 12px rgba(27,26,24,.08)",
    "lg": "0 12px 32px rgba(27,26,24,.10)"
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "base": "200ms",
      "slow": "360ms",
      "marquee": "24s"
    },
    "easing": {
      "standard": "cubic-bezier(.2,.8,.2,1)"
    }
  },
  "breakpoint": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1536px"
  },
  "layout": {
    "containerMax": "1200px",
    "containerPadding": "28px"
  },
  "logo": {
    "strokeRatio": {
      "lg": 0.117,
      "md": 0.1,
      "sm": 0.067
    },
    "tracking": "-0.033em",
    "breakpointPx": {
      "lgAbove": 120,
      "smBelow": 60
    }
  }
}

      "200": "#C5DCAE",
      "300": "#A5C982",
      "400": "#7EB14C",
      "500": "#5E9E1F",
      "600": "#4F861A",
      "700": "#406D15",
      "800": "#315511",
      "900": "#223C0C"
    },
    "miele": {
      "50": "#FEFAF0",

  "semantic": {
    "bg-page": "neutral.50",
    "bg-surface": "neutral.0",
    "bg-raised": "neutral.100",
    "bg-warm": "miele.50",
    "bg-inverse": "neutral.900",
    "bg-brand": "arancia.500",
    "bg-brand-soft": "arancia.50",
    "bg-flavor-arancia": "arancia.500",
    "bg-flavor-arancia-tint": "arancia.50",
    "bg-flavor-lime": "lime.500",
    "bg-flavor-lime-tint": "lime.50",
    "bg-danger": "errore.50",

    "text-primary": "neutral.900",
    "text-secondary": "neutral.700",
    "text-muted": "neutral.600",
    "text-inverse": "neutral.0",
    "text-brand": "arancia.600",
    "text-on-brand": "neutral.900",
    "text-on-flavor": "neutral.0",
    "text-on-flavor-small": "neutral.900",
    "text-danger": "errore.700",

    "border-subtle": "neutral.200",
    "border-default": "neutral.300",
    "border-strong": "neutral.400",
    "border-brand": "arancia.500",
    "border-danger": "errore.500",

    "logo-on-flavor": "neutral.0",
    "logo-on-light": "neutral.900",

    "focus-ring": "arancia.700"
  },
  "font": {
    "display": "'Gabarito', system-ui, sans-serif",
    "text": "'Inter', system-ui, sans-serif",
    "mono": "'DM Mono', ui-monospace, SFMono-Regular, Menlo, monospace",
    "accent": "'Fraunces', Georgia, 'Times New Roman', serif"
  },
  "type": {
    "display-xl": { "size": "84px", "lineHeight": "0.92", "tracking": "-0.05em",  "family": "display", "weight": "900", "case": "lowercase" },
    "display-lg": { "size": "60px", "lineHeight": "0.96", "tracking": "-0.045em", "family": "display", "weight": "900", "case": "lowercase" },
    "display-md": { "size": "42px", "lineHeight": "1.0",  "tracking": "-0.04em",  "family": "display", "weight": "900", "case": "lowercase" },
    "display-sm": { "size": "32px", "lineHeight": "1.05", "tracking": "-0.035em", "family": "display", "weight": "900", "case": "lowercase" },
    "heading-lg": { "size": "26px", "lineHeight": "1.15", "tracking": "-0.03em",  "family": "text",    "weight": "600", "case": "none" },
    "heading-md": { "size": "21px", "lineHeight": "1.2",  "tracking": "-0.02em",  "family": "text",    "weight": "600", "case": "none" },
    "heading-sm": { "size": "18px", "lineHeight": "1.3",  "tracking": "-0.015em", "family": "text",    "weight": "600", "case": "none" },
    "body-lg":    { "size": "18px", "lineHeight": "1.6",  "tracking": "0",        "family": "text",    "weight": "400", "case": "none" },
    "body-md":    { "size": "16px", "lineHeight": "1.6",  "tracking": "0",        "family": "text",    "weight": "400", "case": "none" },
    "body-sm":    { "size": "14px", "lineHeight": "1.55", "tracking": "0",        "family": "text",    "weight": "400", "case": "none" },
    "mono-md":    { "size": "12px", "lineHeight": "1.4",  "tracking": "0.14em",   "family": "mono",    "weight": "500", "case": "uppercase" },
    "mono-sm":    { "size": "10px", "lineHeight": "1.4",  "tracking": "0.16em",   "family": "mono",    "weight": "500", "case": "uppercase" },
    "flavor-lg":  { "size": "32px", "lineHeight": "1.15", "tracking": "-0.01em",  "family": "accent",  "weight": "500", "case": "none", "style": "italic" },
    "flavor":     { "size": "24px", "lineHeight": "1.2",  "tracking": "-0.01em",  "family": "accent",  "weight": "500", "case": "none", "style": "italic" },
    "flavor-sm":  { "size": "20px", "lineHeight": "1.25", "tracking": "0",        "family": "accent",  "weight": "500", "case": "none", "style": "italic" }
  },
  "space": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px",
    "24": "96px",
    "32": "128px"
  },
  "control": {
    "sm": "36px",
    "md": "44px",
    "lg": "56px"
  },
  "radius": {
    "sm": "8px",
    "md": "14px",
    "lg": "22px",
    "xl": "30px",
    "2xl": "44px",
    "full": "9999px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(27,26,24,.06)",
    "md": "0 4px 12px rgba(27,26,24,.08)",
    "lg": "0 12px 32px rgba(27,26,24,.10)"
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "base": "200ms",
      "slow": "360ms",
      "marquee": "24s"
    },
    "easing": {
      "standard": "cubic-bezier(.2,.8,.2,1)"
    }
  },
  "breakpoint": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1536px"
  },
  "layout": {
    "containerMax": "1200px",
    "mediaMax": "1100px",
    "containerPadding": "28px"
  },
  "logo": {
    "tracking": "-0.04em",
    "minWidthPx": 48,
    "minWidthPrintMm": 12,
    "headerWidthPx": { "desktop": 96, "mobile": 80 },
    "flavorVariantMinHeightPx": 48
  },
  "pack": {
    "safe": 0.08,
    "sealBand": 0.08,
    "wordmarkWidth": 0.82,
    "bustaRatio": "2:3",
    "stickRatio": "1:5"
  }
}

{
  "name": "peak-design-system",
  "private": true,
  "version": "3.3.0",
  "type": "module",
  "description": "peak — design system 2.0 e sito dimostrativo. Creatina + glicina + vitamina D3 in stick monodose.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint:compliance": "node scripts/compliance-lint.mjs",
    "tokens:contrast": "node scripts/contrast-report.mjs",
    "tokens:build": "node scripts/build-tokens.mjs",
    "assets:generate": "node scripts/generate-assets.mjs",
    "brand:vectorize": "node scripts/vectorize-wordmark.mjs",
    "docs:brand": "node scripts/build-brand-doc.mjs",
    "docs:screens": "node scripts/screenshots.mjs",
    "check:utilities": "node scripts/check-utilities.mjs",
    "export:logo": "node scripts/export-logo.mjs",
    "export:pack": "node scripts/export-pack.mjs",
    "test": "npm run typecheck && npm run lint:compliance && npm run tokens:contrast && npm run build && npm run check:utilities"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "opentype.js": "^1.3.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
